{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Remote",
  "version": "0.1.0",
  "identifier": "io.github.nideta231.hermesremote.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermes Remote",
        "width": 420,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_UPDATER_PUBKEY_SET_IN_TICKET_08",
      "endpoints": [
        "https://github.com/nideta231/hermes-mobile-remote/releases/latest/download/latest.json"
      ]
    }
  }
}
