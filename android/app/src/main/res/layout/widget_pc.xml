<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_host" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Hermes Remote" android:textColor="#9AA4B8"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="tap to refresh" android:textColor="#E8B54A" android:textSize="11sp" android:paddingStart="8dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_cpu" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="CPU --" android:textColor="#3DDC97" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_mem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="RAM --" android:textColor="#5B8DEF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_temp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="-- °C" android:textColor="#F5A524" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_spark" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY"
        android:contentDescription="CPU and RAM over the last hour" />
    <TextView android:id="@+id/widget_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#6B7488" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
